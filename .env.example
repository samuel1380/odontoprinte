# ODONTOPRINT - VARIÁVEIS DE AMBIENTE
# Preencha com as credenciais do seu projeto Supabase Cloud (Settings > API)

# URL da API do Supabase (Acessível no Browser/Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Key do Supabase (Acessível no Browser/Frontend, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (OPCIONAL/SERVIDOR APENAS - NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# String de conexão direta com o Postgres (SÓ servidor - usada pelo db:migrate).
# Supabase Dashboard > Project Settings > Database > Connection string (URI).
# Ex: postgresql://postgres:SUA-SENHA@db.xxxx.supabase.co:5432/postgres
# No Render, cadastre como segredo DATABASE_URL (nunca commite o valor real).
# DATABASE_URL=

# Ambiente da aplicação
NODE_ENV=development
